# Sanity CMS (required)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Public site URL & base path (optional; defaults to GitHub Pages fallback in astro.config.mjs)
# For custom domain (.se) or root repo (username.github.io), set BASE_PATH=/
SITE_URL=
BASE_PATH=

# Sanity viewer token for preview mode (drafts).
# Used only during `dev:preview` and `build:preview` on server/build.
# NEVER add a PUBLIC_ prefix to this variable to avoid leaking it to the browser.
SANITY_API_READ_TOKEN=

# Sanity editor/write token for migration and maintenance scripts (e.g. scripts/init-order-rank.ts).
# Requires Editor permissions. NEVER add a PUBLIC_ prefix to this variable.
SANITY_API_WRITE_TOKEN=
