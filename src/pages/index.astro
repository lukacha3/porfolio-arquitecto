---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import AboutSection from "../components/AboutSection.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import StudioSection from "../components/StudioSection.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { getProjects, getCategories, getSiteSettings } from "../lib/queries";
import { portableTextToPlainText } from "../lib/portableText";
import { hasStudioContent } from "../lib/studio";
import { urlFor } from "../lib/sanity";

const [projects, categories, siteSettings] = await Promise.all([
  getProjects(),
  getCategories(),
  getSiteSettings(),
]);

// Portrait URL (used for OG image and JSON-LD)
const portraitUrl = siteSettings?.portrait?.asset
  ? urlFor(siteSettings.portrait).width(1200).auto("format").quality(85).url()
  : undefined;

// Fallback OG Image to first project's cover image if no portrait is set
const firstProjectCoverUrl = projects[0]?.coverImage?.asset
  ? urlFor(projects[0].coverImage).width(1200).auto("format").quality(85).url()
  : undefined;

const ogImage = portraitUrl || firstProjectCoverUrl;

const homeDescription = portableTextToPlainText(
  siteSettings?.aboutText,
  siteSettings?.about || site.page.description
);

// JSON-LD structured data for Home
const siteOrigin = Astro.site ? new URL(Astro.site).origin : Astro.url.origin;
const sameAs = [siteSettings?.instagram, siteSettings?.linkedin].filter(Boolean) as string[];

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: siteSettings?.studioName || site.studioName,
  url: siteOrigin,
  description: homeDescription,
  ...(portraitUrl ? { image: portraitUrl } : {}),
  ...(siteSettings?.email ? { email: siteSettings.email } : {}),
  ...(sameAs.length > 0 ? { sameAs } : {}),
};
const showStudio = hasStudioContent(siteSettings);
---

<Layout
  title={siteSettings?.studioName ? `${siteSettings.studioName} — Arkitektur` : undefined}
  description={homeDescription}
  image={ogImage}
  jsonLd={organizationJsonLd}
>
  <Header studioName={siteSettings?.studioName} showStudio={showStudio} />

  <main id="main">
    <AboutSection
      headline={siteSettings?.headline}
      aboutText={siteSettings?.aboutText}
      fallbackAbout={siteSettings?.about}
      portrait={siteSettings?.portrait}
      tools={siteSettings?.tools}
      education={siteSettings?.education}
      studioName={siteSettings?.studioName}
    />
    <ProjectGrid
      projects={projects}
      categories={categories}
      hasStudio={showStudio}
    />
    {showStudio && (
      <StudioSection
        about={siteSettings?.about}
        services={siteSettings?.services}
      />
    )}
  </main>

  <Footer
    email={siteSettings?.email}
    instagram={siteSettings?.instagram}
    linkedin={siteSettings?.linkedin}
    cvUrl={siteSettings?.cvUrl}
    cvLabel={siteSettings?.cvLabel}
    copyright={siteSettings?.studioName ? `© ${siteSettings.studioName}` : undefined}
  />
</Layout>
