---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectGallery from "../../components/ProjectGallery.astro";
import ProjectPlans from "../../components/ProjectPlans.astro";
import PlaceholderArt from "../../components/PlaceholderArt.astro";
import { site } from "../../data/site";
import {
  getProjects,
  getProjectBySlug,
  getSiteSettings,
  type SanityProjectDetail,
  type SanityProject,
  type SanitySiteSettings,
} from "../../lib/queries";
import { getImageProps } from "../../lib/images";
import { urlFor } from "../../lib/sanity";

export async function getStaticPaths() {
  const projects = await getProjects();
  const siteSettings = await getSiteSettings();

  return await Promise.all(
    projects.map(async (p, index) => {
      const fullProject = await getProjectBySlug(p.slug);
      const nextProject = projects[(index + 1) % projects.length];
      return {
        params: { slug: p.slug },
        props: {
          project: fullProject || p,
          nextProject,
          siteSettings,
        },
      };
    })
  );
}

interface Props {
  project: SanityProjectDetail;
  nextProject: SanityProject;
  siteSettings: SanitySiteSettings | null;
}

const { project, nextProject, siteSettings } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Studio name and page title
const studioName = siteSettings?.studioName || site.studioName;
const pageTitle = `${project.title} — ${studioName}`;

const taglineText = project.tagline?.trim() || "";

// Combine tagline and description for SEO meta without cutting words
function buildMetaDescription(tagline?: string | null, description?: string | null): string {
  const t = tagline?.trim() || "";
  const d = description?.trim() || "";
  const combined = t && d ? `${t} — ${d}` : t || d;
  if (!combined) return site.page.description;
  const clean = combined.replace(/\s+/g, " ").trim();
  if (clean.length <= 155) return clean;
  const sub = clean.slice(0, 155);
  const lastSpace = sub.lastIndexOf(" ");
  return (lastSpace > 0 ? sub.slice(0, lastSpace) : sub) + "…";
}

const metaDescription = buildMetaDescription(project.tagline, project.description);

// OG image URL
const ogImageUrl = project.coverImage?.asset
  ? urlFor(project.coverImage).width(1200).auto("format").quality(85).url()
  : undefined;

// Description paragraphs
const descriptionParagraphs = project.description
  ? project.description.split(/\r?\n+/).filter(Boolean)
  : [];
const hasDescription = descriptionParagraphs.length > 0;

// Valid technical specs / facts ("Fakta")
const validSpecs = (project.specs || []).filter(
  (s) => Boolean(s?.label?.trim()) && Boolean(s?.value?.trim())
);
const hasSpecs = validSpecs.length > 0;

// Next project image helper
const nextImage = nextProject ? getImageProps(nextProject.coverImage) : null;
const nextAmbientSrc = nextProject?.coverImage?.asset
  ? urlFor(nextProject.coverImage).width(64).auto("format").quality(50).url()
  : null;

// JSON-LD structured data for Project
const siteOrigin = Astro.site ? new URL(Astro.site).origin : "https://lukacha3.github.io";
const projectUrl = new URL(Astro.url.pathname, siteOrigin).href;

const projectJsonLd = {
  "@context": "https://schema.org",
  "@type": "VisualArtwork",
  name: project.title,
  url: projectUrl,
  description: project.description || taglineText || metaDescription,
  ...(project.year ? { dateCreated: String(project.year) } : {}),
  ...(project.photographer ? { creator: { "@type": "Person", name: project.photographer } } : {}),
  ...(ogImageUrl ? { image: ogImageUrl } : {}),
};
---

<Layout title={pageTitle} description={metaDescription} image={ogImageUrl} jsonLd={projectJsonLd}>
  <Header studioName={studioName} />

  <main id="main" class="project-main">
    <!-- Back link -->
    <div class="project-container project-back-row">
      <a href={`${base}/#projekt`} class="back-link">
        ← {site.projectPage.back}
      </a>
    </div>

    <!-- 1. Photo Gallery (top of the page) -->
    <ProjectGallery
      coverImage={project.coverImage}
      gallery={project.gallery}
      projectTitle={project.title}
    />

    <!-- 2. Title + Tagline + Meta (Left) & Description (Right) -->
    <section
      class:list={[
        "project-container",
        "project-info-section",
        { "project-info-section--two-col": hasDescription },
      ]}
    >
      <header class="project-info-left">
        <h1 class="project-title">
          {project.title}
        </h1>

        {taglineText && (
          <p class="project-tagline">
            {taglineText}
          </p>
        )}

        {(project.category?.title || project.year || project.photographer) && (
          <dl class="project-meta">
            {project.category?.title && (
              <div class="project-meta__item">
                <dt>{site.projectPage.category}:</dt>
                <dd>{project.category.title}</dd>
              </div>
            )}
            {project.year && (
              <div class="project-meta__item">
                <dt>{site.projectPage.year}:</dt>
                <dd>{project.year}</dd>
              </div>
            )}
            {project.photographer && (
              <div class="project-meta__item">
                <dt>{site.projectPage.photographer}:</dt>
                <dd>{project.photographer}</dd>
              </div>
            )}
          </dl>
        )}
      </header>

      {hasDescription && (
        <div class="project-description">
          {descriptionParagraphs.map((para) => (
            <p class="project-description__text">
              {para}
            </p>
          ))}
        </div>
      )}
    </section>

    <!-- 3. Technical Specs / Facts Row ("Fakta") -->
    {hasSpecs && (
      <section
        class="project-container project-specs-section"
        aria-label="Fakta"
      >
        <dl class="project-specs-grid">
          {validSpecs.map((spec) => (
            <div class="project-spec-box">
              <dt class="project-spec-box__label">{spec.label}</dt>
              <dd class="project-spec-box__value">{spec.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <!-- 4. Floor Plans (optional) -->
    <ProjectPlans
      plans={project.plans}
      hasPlans={project.hasPlans}
      projectTitle={project.title}
    />

    <!-- 5. Next Project -->
    {nextProject && (
      <section
        class="next-project-section"
        style="
          position: relative;
          isolation: isolate;
          padding-top: 80px;
          padding-bottom: 140px;
          border-top: 1px solid var(--color-line);
        "
      >
        <div
          class="next-project-banner"
          style="
            position: relative;
            z-index: 2;
            background: var(--color-ink);
            color: var(--color-ground);
            padding: 24px var(--spacing-gutter);
            margin-bottom: 56px;
          "
        >
          <h2
            class="section-title"
            style="margin: 0;"
          >
            {site.projectPage.nextProject}
          </h2>
        </div>

        <div style="padding: 0 var(--spacing-gutter);">
          <a
            href={`${base}/projekt/${nextProject.slug}`}
            class="next-project-link"
            aria-label={`${site.projectPage.nextProject}: ${nextProject.title}`}
            style="
              display: block;
              text-decoration: none;
              color: inherit;
            "
          >
            <div class="next-project-media-wrap">
              {nextImage && nextAmbientSrc && (
                <div class="next-project-ambient" aria-hidden="true">
                  <img
                    src={nextAmbientSrc}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                    style={`object-position: ${nextImage.objectPosition};`}
                  />
                </div>
              )}

              <div
                class="next-project-image-box"
                style="
                  position: relative;
                  z-index: 2;
                  width: 100%;
                  height: clamp(300px, 45vw, 560px);
                  overflow: hidden;
                  border-radius: var(--radius-image);
                  isolation: isolate;
                  transform: translateZ(0);
                  background: var(--color-surface, #e5e5e5);
                  margin-bottom: 24px;
                "
              >
                {nextImage ? (
                  <img
                    src={nextImage.src}
                    srcset={nextImage.srcset}
                    sizes="100vw"
                    width={nextImage.width}
                    height={nextImage.height}
                    alt={nextImage.alt}
                    loading="lazy"
                    decoding="async"
                    style={`
                      width: 100%;
                      height: 100%;
                      object-fit: cover;
                      object-position: ${nextImage.objectPosition};
                      display: block;
                    `}
                  />
                ) : (
                  <PlaceholderArt variant="hero" id={nextProject.slug} />
                )}
              </div>
            </div>

            <div
              style="
                position: relative;
                z-index: 2;
                display: flex;
                justify-content: space-between;
                align-items: baseline;
              "
            >
              <span
                style="
                  font-size: var(--text-h2);
                  font-weight: 300;
                  letter-spacing: -0.03em;
                "
              >
                {nextProject.title}
              </span>
              <span class="next-arrow" aria-hidden="true" style="font-size: 28px; opacity: 0.5;">
                →
              </span>
            </div>
          </a>
        </div>
      </section>
    )}
  </main>

  <Footer
    email={siteSettings?.email}
    instagram={siteSettings?.instagram}
    linkedin={siteSettings?.linkedin}
    copyright={studioName ? `© ${studioName}` : undefined}
  />
</Layout>

<style>
  .project-main {
    padding-top: 24px;
  }

  .project-container {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }

  .project-back-row {
    margin-bottom: 16px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    text-decoration: none;
    padding: 8px 0;
  }

  .back-link:hover {
    color: var(--color-ink) !important;
  }

  .back-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* ── 2. Title + Description Two-Column Block ─────────────────── */
  .project-info-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: start;
    padding-top: 16px;
    padding-bottom: 56px;
  }

  @media (min-width: 900px) {
    .project-info-section--two-col {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: clamp(48px, 6vw, 96px);
    }
  }

  .project-info-left {
    min-width: 0;
  }

  .project-title {
    font-size: calc(var(--text-h2) - 2pt);
    font-weight: 300;
    line-height: 1.06;
    letter-spacing: -0.03em;
    margin: 0 0 16px;
  }

  .project-tagline {
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    font-weight: 300;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--color-muted);
    margin: 0 0 24px;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: 24px 0 0;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .project-meta__item {
    display: flex;
    gap: 8px;
  }

  .project-meta__item dt {
    color: var(--color-ink-soft);
  }

  .project-meta__item dd {
    margin: 0;
    color: var(--color-ink);
  }

  .project-description {
    min-width: 0;
    max-width: 68ch;
  }

  .project-description__text {
    font-size: 20px; /* <-- TAMAÑO DE FUENTE DE LA DESCRIPCIÓN (Beskrivning): cambiá este valor (ej. 18px, 20px, 22px, 24px) */
    font-weight: 300;
    line-height: 1.55;
    letter-spacing: -0.01em;
    text-align: justify;
    hyphens: auto;
    margin: 0 0 20px;
  }

  .project-description__text:last-child {
    margin-bottom: 0;
  }

  /* ── 3. Technical Specs / Facts Row ("Fakta") ────────────────── */
  .project-specs-section {
    padding-top: 40px;
    padding-bottom: 56px;
    border-top: 1px solid var(--color-line);
  }

  .project-specs-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 24px;
    margin: 0;
  }

  @media (min-width: 768px) {
    .project-specs-grid {
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 32px 28px;
    }
  }

  .project-spec-box {
    min-width: 0;
  }

  .project-spec-box__label {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin: 0 0 10px;
  }

  .project-spec-box__value {
    margin: 0;
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    font-weight: 300;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }

  /* ── 5. Next Project ─────────────────────────────────────────── */
  .next-project-media-wrap {
    position: relative;
  }

  .next-project-ambient {
    --ambient-x: 0px;
    --ambient-y: 0px;
    display: none;
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    border-radius: var(--radius-image);
    opacity: 0;
    transform: translate3d(0, 0, 0) scale(1.01);
    filter: blur(48px) saturate(1.35);
    transition:
      opacity 450ms ease,
      transform 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .next-project-ambient img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-image);
    display: block;
  }

  .next-project-image-box img,
  .next-project-image-box svg {
    transition: transform 1.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .next-project-ambient {
      display: block;
    }

    .next-project-link:hover .next-project-ambient {
      opacity: 0.45;
      transform: translate3d(var(--ambient-x, 0px), var(--ambient-y, 0px), 0) scale(1.06);
      transition:
        opacity 450ms ease,
        transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
      will-change: opacity, transform;
    }
  }

  @media (hover: hover) {
    .next-project-link:hover .next-project-image-box img,
    .next-project-link:hover .next-project-image-box svg {
      transform: scale(1.035);
    }

    .next-project-link:hover .next-arrow {
      transform: translateX(8px);
      opacity: 1 !important;
    }
  }

  .next-project-link:focus-visible .next-project-ambient {
    display: block;
    opacity: 0.45;
    transform: translate3d(0, 0, 0) scale(1.06);
  }

  .next-arrow {
    display: inline-block;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .next-project-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .next-project-image-box img,
    .next-project-image-box svg,
    .next-project-ambient,
    .next-arrow {
      transition: none;
      transform: none !important;
    }
  }
</style>

<script>
  function initNextProjectAmbient() {
    if (
      window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
      !window.matchMedia("(hover: hover) and (pointer: fine)").matches
    ) {
      return;
    }

    const MAX_SHIFT_X = 24;
    const MAX_SHIFT_Y = 20;

    document.querySelectorAll<HTMLElement>(".next-project-media-wrap").forEach((wrap) => {
      if (wrap.dataset.ambientBound === "true") return;
      const ambient = wrap.querySelector<HTMLElement>(".next-project-ambient");
      if (!ambient) return;
      wrap.dataset.ambientBound = "true";

      let rafId = 0;

      wrap.addEventListener(
        "pointermove",
        (e: PointerEvent) => {
          if (e.pointerType !== "mouse") return;
          cancelAnimationFrame(rafId);
          const clientX = e.clientX;
          const clientY = e.clientY;

          rafId = requestAnimationFrame(() => {
            const rect = wrap.getBoundingClientRect();
            if (rect.width === 0 || rect.height === 0) return;

            const nx = ((clientX - rect.left) / rect.width - 0.5) * 2;
            const ny = ((clientY - rect.top) / rect.height - 0.5) * 2;

            ambient.style.setProperty("--ambient-x", `${(nx * MAX_SHIFT_X).toFixed(1)}px`);
            ambient.style.setProperty("--ambient-y", `${(ny * MAX_SHIFT_Y).toFixed(1)}px`);
          });
        },
        { passive: true }
      );

      wrap.addEventListener(
        "pointerleave",
        () => {
          cancelAnimationFrame(rafId);
          ambient.style.setProperty("--ambient-x", "0px");
          ambient.style.setProperty("--ambient-y", "0px");
        },
        { passive: true }
      );
    });
  }

  initNextProjectAmbient();
  document.addEventListener("astro:page-load", initNextProjectAmbient);
</script>
