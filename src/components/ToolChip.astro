---
import type { ToolDefinition } from "../data/tools";

interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
---

<li
  class="tool-chip"
  style={`--brand: ${tool.brandColor};`}
  data-placeholder={tool.isPlaceholder ? "true" : undefined}
>
  <span class="tool-chip__icon" set:html={tool.svg} />
  <span class="tool-chip__name">{tool.name}</span>
</li>

<style>
  .tool-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border-radius: 8px;
    border: 1px solid var(--color-line);
    background-color: transparent;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1;
    letter-spacing: 0.04em;
    user-select: none;
    transition:
      border-color 200ms ease,
      color 200ms ease,
      background-color 200ms ease,
      box-shadow 200ms ease;
  }

  .tool-chip__icon {
    width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--color-ink);
    transition: color 200ms ease;
  }

  .tool-chip__icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .tool-chip__name {
    color: var(--color-ink);
    transition: color 200ms ease;
  }

  @media (hover: hover) {
    .tool-chip:hover {
      border-color: var(--brand);
      color: var(--brand);
      background-color: color-mix(in srgb, var(--brand) 8%, transparent);
      box-shadow: 0 0 14px color-mix(in srgb, var(--brand) 20%, transparent);
    }

    .tool-chip:hover .tool-chip__icon,
    .tool-chip:hover .tool-chip__name {
      color: var(--brand);
    }
  }

  .tool-chip:focus-visible {
    border-color: var(--brand);
    color: var(--brand);
    background-color: color-mix(in srgb, var(--brand) 8%, transparent);
    box-shadow: 0 0 14px color-mix(in srgb, var(--brand) 20%, transparent);
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .tool-chip:focus-visible .tool-chip__icon,
  .tool-chip:focus-visible .tool-chip__name {
    color: var(--brand);
  }

  @media (prefers-reduced-motion: reduce) {
    .tool-chip,
    .tool-chip__icon,
    .tool-chip__name {
      transition: none;
    }
  }
</style>
