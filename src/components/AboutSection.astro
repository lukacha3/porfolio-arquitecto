---
import { site } from "../data/site";
import type { SanityCoverImage, SanityPortableTextBlock } from "../lib/queries";
import { getImageProps } from "../lib/images";
import { renderAboutParagraphs } from "../lib/portableText";
import { resolveTools } from "../data/tools";
import ToolChip from "./ToolChip.astro";

interface Props {
  headline?: string | null;
  aboutText?: SanityPortableTextBlock[] | string | null;
  fallbackAbout?: string | null;
  portrait?: SanityCoverImage | null;
  tools?: string[] | null;
  studioName?: string | null;
}

const {
  aboutText,
  fallbackAbout,
  portrait,
  tools,
  studioName,
} = Astro.props;

const paragraphs = renderAboutParagraphs(
  aboutText,
  fallbackAbout || site.aboutMe.defaultText
);
const resolvedTools = resolveTools(tools);
const portraitProps = getImageProps(portrait);
const hasPortrait = Boolean(portraitProps);
const portraitAlt =
  portraitProps?.alt?.trim() || studioName || site.studioName;
---

<section
  id="om-mig"
  class:list={["about-section", { "about-section--with-portrait": hasPortrait }]}
  aria-labelledby="about-heading"
>
  <div class="about-container">
    <div class="about-grid">
      <!-- Left Column: Section Heading (H1) + Bio + Tools -->
      <div class="about-left">
        <div class="about-card about-reveal">
          <h1 id="about-heading" class="section-title about-heading">
            {site.aboutMe.label}
          </h1>

          {paragraphs.length > 0 && (
            <div class="about-prose">
              {paragraphs.map((paraHtml) => (
                <p set:html={paraHtml} />
              ))}
            </div>
          )}
        </div>

        {resolvedTools.length > 0 && (
          <div class="about-tools about-reveal">
            <span class="about-tools__label">{site.aboutMe.toolsLabel}</span>
            <ul class="about-tools__list" aria-label={site.aboutMe.toolsLabel}>
              {resolvedTools.map((tool) => (
                <ToolChip tool={tool} />
              ))}
            </ul>
          </div>
        )}
      </div>

      <!-- Right Column: Portrait (only rendered when uploaded in Sanity) -->
      {portraitProps && (
        <div class="about-right about-reveal">
          <figure class="about-portrait">
            <img
              src={portraitProps.src}
              srcset={portraitProps.srcset}
              sizes="(min-width: 900px) 400px, 85vw"
              width={portraitProps.width}
              height={portraitProps.height}
              alt={portraitAlt}
              loading="eager"
              fetchpriority="high"
              style={`object-position: ${portraitProps.objectPosition};`}
            />
          </figure>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: 72px var(--spacing-gutter) 24px;
  }

  .about-container {
    max-width: 1080px;
    margin-inline: auto;
  }

  .about-section--with-portrait .about-container {
    max-width: 1150px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }

  @media (min-width: 900px) {
    .about-section--with-portrait .about-grid {
      grid-template-columns: 1.3fr 1fr;
      gap: clamp(48px, 6vw, 100px);
      align-items: stretch;
    }
  }

  .about-left {
    min-width: 0;
    width: 100%;
    margin-left: 20px;
  }

  .about-card {
    max-width: 80ch;
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--radius-image);
    border: 1px solid var(--color-line);
    background-color: color-mix(in srgb, var(--color-ink) 2%, var(--color-ground));
    margin-bottom: 28px;
    transition:
      border-color 280ms ease,
      box-shadow 280ms ease,
      background-color 280ms ease;
  }

  @media (hover: hover) {
    .about-card:hover {
      border-color: color-mix(in srgb, var(--color-accent) 70%, var(--color-line));
      background-color: color-mix(in srgb, var(--color-accent) 4%, var(--color-ground));
      box-shadow: 0 0 24px color-mix(in srgb, var(--color-accent) 22%, transparent);
    }
  }

  .about-heading {
    margin: 0 0 20px;
  }

  .about-prose {
    max-width: 100%;
    margin-bottom: 0;
  }

  .about-prose p {
    font-size: calc(clamp(1.125rem, 1.6vw, 1.375rem) - 2pt);
    font-weight: 300;
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    text-align: justify;
    hyphens: auto;
    margin: 0 0 20px;
  }

  .about-prose p:last-child {
    margin-bottom: 0;
  }

  .about-prose :global(strong) {
    font-weight: 500;
  }

  .about-prose :global(em) {
    font-style: italic;
  }

  .about-prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
    decoration-thickness: 1px;
    transition: color 0.2s ease;
  }

  @media (hover: hover) {
    .about-prose :global(a:hover) {
      color: var(--color-accent);
    }
  }

  .about-tools {
    padding-top: 8px;
    max-width: 80ch;
  }

  .about-tools__label {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin-bottom: 16px;
  }

  .about-tools__list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .about-right {
    width: 100%;
    max-width: 360px;
    margin-inline: auto;
  }

  .about-portrait {
    margin: 0;
    width: 100%;
    background: transparent;
  }

  .about-portrait img {
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-image);
    display: block;
  }

  @media (min-width: 900px) {
    .about-right {
      position: relative;
      left: -30px; /* <-- Positivo = derecha, Negativo = izquierda (ej. -30px o 30px) */
      top: 0px;  /* <-- Positivo = abajo, Negativo = arriba (ej. -20px o 20px) */
      max-width: none;
      margin-inline: 0;
      align-self: stretch;
    }

    .about-portrait {
      position: absolute;
      inset: 0;
      display: flex;
      justify-content: flex-end;
      align-items: stretch;
    }

    .about-portrait img {
      width: auto;
      max-width: 100%;
      height: 100%;
      object-fit: contain;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-card {
      transition: none;
    }
  }
</style>
