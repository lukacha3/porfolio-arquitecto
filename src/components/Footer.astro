---
import { site } from "../data/site";
---

<footer
  id="kontakt"
  style="
    background: var(--color-ink);
    color: var(--color-ground);
    padding: 120px var(--spacing-gutter) 40px;
  "
>
  <!-- Closing heading -->
  <h2
    style="
      font-size: var(--text-closing);
      font-weight: 300;
      line-height: 1;
      letter-spacing: -0.04em;
      max-width: 12ch;
      margin: 0;
    "
  >
    {site.footer.closing}
  </h2>

  <!-- Email link -->
  <a
    href={`mailto:${site.footer.email}`}
    style="
      display: inline-block;
      margin-top: 48px;
      padding: 8px 0;
      font-size: clamp(1.25rem, 2.6vw, 2rem);
      border-bottom: 1px solid var(--color-accent);
      color: inherit;
      text-decoration: none;
    "
    class="email-link"
  >
    {site.footer.email}
  </a>

  <!-- Bottom row -->
  <div
    style="
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      margin-top: 120px;
      font-family: var(--font-mono);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-ink-soft);
      gap: 16px;
    "
  >
    <span>{site.footer.copyright}</span>

    <nav aria-label="Sociala medier">
      <ul
        style="
          display: flex;
          gap: 32px;
          list-style: none;
          margin: 0;
          padding: 0;
        "
      >
        {site.footer.socials.map((social) => (
          <li>
            <a
              href={social.href}
              class="social-link"
              style="padding: 12px 0; display: inline-block; color: inherit;"
            >
              {social.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .email-link:hover {
    opacity: 0.75;
  }
  .email-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .social-link {
    text-decoration: none;
    color: inherit;
  }
  .social-link:hover {
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  .social-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }
</style>
