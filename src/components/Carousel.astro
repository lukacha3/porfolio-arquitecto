---
import type { SanityCoverImage, SanityPlanImage } from "../lib/queries";
import { getImageProps } from "../lib/images";
import { site } from "../data/site";

export interface CarouselSlide {
  image: SanityCoverImage | SanityPlanImage;
  caption?: string | null;
  alt?: string;
}

interface Props {
  slides: CarouselSlide[];
  ariaLabel: string;
  variant?: "photos" | "plans";
  eagerFirst?: boolean;
}

const {
  slides = [],
  ariaLabel,
  variant = "photos",
  eagerFirst = false,
} = Astro.props;

const validSlides = slides.filter((s) => Boolean(s?.image?.asset));
const total = validSlides.length;
const isSingle = total <= 1;
const isPlans = variant === "plans";
---

{total > 0 && (
  <div
    class:list={["gallery-container", { "gallery-container--plans": isPlans }]}
    role="region"
    aria-label={ariaLabel}
    data-carousel
    data-lenis-prevent
  >
    <!-- Track -->
    <div
      class:list={["gallery-track", { "is-single": isSingle }]}
      tabindex="0"
      role="region"
      aria-label="Bläddra med piltangenter eller scroll"
      data-carousel-track
      data-lenis-prevent
    >
      {validSlides.map((slide, idx) => {
        const imgProps = getImageProps(slide.image);
        if (!imgProps) return null;

        const isFirst = idx === 0;
        const shouldEager = eagerFirst && isFirst;
        const isPortrait = imgProps.height > imgProps.width;
        const aspectRatio = (imgProps.width / imgProps.height).toFixed(4);
        const altText = slide.alt ?? imgProps.alt;
        const captionText = isPlans ? slide.caption?.trim() : undefined;
        const objectPos = isPlans ? "50% 50%" : imgProps.objectPosition;

        return (
          <figure
            class:list={[
              "gallery-item",
              {
                "gallery-item--plan": isPlans,
                "is-active": isFirst,
                "is-portrait": isPortrait,
              },
            ]}
            data-index={idx}
            tabindex="0"
            role="group"
            aria-roledescription="slide"
            aria-label={`${idx + 1} av ${total}${altText ? `: ${altText}` : ""}`}
            aria-current={isFirst ? "true" : undefined}
            style={`--item-aspect-ratio: ${aspectRatio};`}
          >
            <div class="gallery-media">
              <img
                src={imgProps.src}
                srcset={imgProps.srcset}
                sizes="(min-width: 768px) 60vw, 80vw"
                width={imgProps.width}
                height={imgProps.height}
                alt={altText}
                loading={shouldEager ? "eager" : "lazy"}
                decoding={shouldEager ? "auto" : "async"}
                fetchpriority={shouldEager ? "high" : "auto"}
                style={`
                  height: 100%;
                  width: 100%;
                  max-width: 100%;
                  max-height: 100%;
                  object-fit: contain;
                  object-position: ${objectPos};
                  display: block;
                `}
              />
            </div>
            {isPlans && captionText && (
              <figcaption class="gallery-caption">
                {captionText}
              </figcaption>
            )}
          </figure>
        );
      })}
    </div>

    <!-- Controls (only if more than 1 item) -->
    {!isSingle && (
      <div class="gallery-controls">
        <span
          class="gallery-counter"
          aria-live="polite"
          data-carousel-counter
        >
          <span class="current-index">1</span> / {total}
        </span>

        <div class="gallery-nav-buttons">
          <button
            type="button"
            class="gallery-btn prev-btn"
            aria-label={site.projectPage.previous}
            data-carousel-prev
            disabled
          >
            ←
          </button>
          <button
            type="button"
            class="gallery-btn next-btn"
            aria-label={site.projectPage.next}
            data-carousel-next
          >
            →
          </button>
        </div>
      </div>
    )}
  </div>
)}

<style>
  .gallery-container {
    --slide-width: 60vw;
    --slide-img-height: clamp(320px, 70vh, 720px);
    --gallery-gap: 5vw;
    --slide-opacity: 0.55;
    --slide-scale: 0.96;
    --slide-transition-duration: 400ms;

    width: 100%;
    margin: 48px 0 64px;
    position: relative;
  }

  .gallery-container--plans {
    margin: 24px 0 0;
  }

  @media (max-width: 767px) {
    .gallery-container {
      --slide-width: 80vw;
      --slide-img-height: clamp(280px, 60vh, 500px);
      --gallery-gap: 4vw;
      --slide-opacity: 0.6;
      --slide-scale: 0.97;
      --slide-transition-duration: 350ms;
    }
  }

  .gallery-track {
    display: flex;
    gap: var(--gallery-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-inline: calc((100% - var(--slide-width)) / 2);
    padding-block: 0;
    cursor: grab;
  }

  .gallery-track.is-single {
    justify-content: center;
    overflow-x: hidden;
    cursor: default;
    padding-inline: 0;
  }

  .gallery-track::-webkit-scrollbar {
    display: none;
  }

  .gallery-track:focus-visible,
  .gallery-item:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .gallery-item {
    --calculated-width: min(
      calc(var(--slide-img-height) * var(--item-aspect-ratio, 1.777)),
      var(--slide-width)
    );
    margin: 0;
    padding: 0;
    flex: 0 0 var(--calculated-width);
    width: var(--calculated-width);
    height: var(--slide-img-height);
    scroll-snap-align: center;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Plans slide: image row + reserved caption row so height never jumps */
  .gallery-item--plan {
    height: auto;
    display: grid;
    grid-template-rows: var(--slide-img-height) minmax(36px, auto);
    align-items: start;
    justify-items: center;
  }

  .gallery-media {
    width: 100%;
    height: var(--slide-img-height);
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
  }

  .gallery-caption {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--color-ink-soft);
    text-align: center;
    max-width: 65ch;
    transition:
      opacity var(--slide-transition-duration) ease,
      transform var(--slide-transition-duration) ease;
  }

  /* Progressive enhancement: opacity and subtle scale on inactive items */
  .gallery-container.gallery--enhanced .gallery-item {
    cursor: pointer;
  }

  .gallery-container.gallery--enhanced .gallery-item img {
    opacity: var(--slide-opacity);
    transform: scale(var(--slide-scale));
    transition:
      opacity var(--slide-transition-duration) ease,
      transform var(--slide-transition-duration) ease;
    will-change: opacity, transform;
  }

  .gallery-container.gallery--enhanced .gallery-item:not(.is-active) .gallery-caption {
    opacity: 0;
    transform: translateY(4px);
    pointer-events: none;
  }

  .gallery-container.gallery--enhanced .gallery-item.is-active {
    cursor: default;
  }

  .gallery-container.gallery--enhanced .gallery-item.is-active img {
    opacity: 1;
    transform: scale(1);
  }

  .gallery-container.gallery--enhanced .gallery-item.is-active .gallery-caption {
    opacity: 1;
    transform: translateY(0);
  }

  .gallery-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px var(--spacing-gutter) 0;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .gallery-nav-buttons {
    display: flex;
    gap: 12px;
  }

  .gallery-btn {
    background: transparent;
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
    width: 44px;
    height: 44px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 16px;
    transition: background 0.2s, color 0.2s, opacity 0.2s;
  }

  .gallery-btn:hover:not(:disabled) {
    background: var(--color-ink);
    color: var(--color-ground);
  }

  .gallery-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    border-color: var(--color-line);
    color: var(--color-muted);
  }

  .gallery-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-track {
      scroll-behavior: auto !important;
    }

    .gallery-container.gallery--enhanced .gallery-item img,
    .gallery-caption {
      transition: none !important;
    }
  }
</style>

<script>
  function initCarouselInstance(container: HTMLElement) {
    if (container.dataset.carouselInitialized === "true") return;
    container.dataset.carouselInitialized = "true";

    const track = container.querySelector<HTMLElement>("[data-carousel-track]");
    if (!track) return;

    const items = track.querySelectorAll<HTMLElement>(".gallery-item");
    if (items.length <= 1) return;

    // Enable enhanced visual effects now that JS is available
    container.classList.add("gallery--enhanced");

    const counterSpan = container.querySelector<HTMLElement>(
      "[data-carousel-counter] .current-index"
    );
    const prevBtn = container.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const nextBtn = container.querySelector<HTMLButtonElement>("[data-carousel-next]");

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const scrollBehavior: ScrollBehavior = prefersReducedMotion ? "auto" : "smooth";

    let currentIndex = 0;

    // Dynamic padding so both the first and last slides (whether horizontal or vertical) can center
    function updateTrackPadding() {
      if (!track || items.length === 0) return;
      const firstRect = items[0].getBoundingClientRect();
      const lastRect = items[items.length - 1].getBoundingClientRect();
      const padStart = Math.max(0, (track.clientWidth - firstRect.width) / 2);
      const padEnd = Math.max(0, (track.clientWidth - lastRect.width) / 2);
      track.style.paddingInlineStart = `${padStart}px`;
      track.style.paddingInlineEnd = `${padEnd}px`;
    }

    function updateActiveState(index: number) {
      if (index < 0 || index >= items.length) return;
      currentIndex = index;

      items.forEach((item, idx) => {
        const isActive = idx === index;
        item.classList.toggle("is-active", isActive);
        if (isActive) {
          item.setAttribute("aria-current", "true");
        } else {
          item.removeAttribute("aria-current");
        }
      });

      if (counterSpan) {
        counterSpan.textContent = String(index + 1);
      }
      if (prevBtn) {
        prevBtn.disabled = index === 0;
      }
      if (nextBtn) {
        nextBtn.disabled = index >= items.length - 1;
      }
    }

    // Centering scroll function based on target slide's center
    function scrollToIndex(index: number) {
      if (!track || index < 0 || index >= items.length) return;
      const target = items[index];
      if (!target) return;

      const targetLeft = target.offsetLeft - (track.clientWidth - target.clientWidth) / 2;
      track.scrollTo({
        left: targetLeft,
        behavior: scrollBehavior,
      });
      updateActiveState(index);
    }

    // Determine the active item based on which item's center is closest to track center
    function getActiveIndex(): number {
      if (!track) return currentIndex;
      const trackRect = track.getBoundingClientRect();
      const trackCenter = trackRect.left + trackRect.width / 2;
      let closestIndex = currentIndex;
      let minDistance = Infinity;

      items.forEach((item, idx) => {
        const rect = item.getBoundingClientRect();
        const itemCenter = rect.left + rect.width / 2;
        const dist = Math.abs(itemCenter - trackCenter);
        if (dist < minDistance) {
          minDistance = dist;
          closestIndex = idx;
        }
      });

      return closestIndex;
    }

    // Controls
    prevBtn?.addEventListener("click", () => {
      if (currentIndex > 0) {
        scrollToIndex(currentIndex - 1);
      }
    });

    nextBtn?.addEventListener("click", () => {
      if (currentIndex < items.length - 1) {
        scrollToIndex(currentIndex + 1);
      }
    });

    // Keyboard navigation scoped strictly to the focused carousel track
    track.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        if (currentIndex > 0) scrollToIndex(currentIndex - 1);
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        if (currentIndex < items.length - 1) scrollToIndex(currentIndex + 1);
      } else if (e.key === "Home") {
        e.preventDefault();
        scrollToIndex(0);
      } else if (e.key === "End") {
        e.preventDefault();
        scrollToIndex(items.length - 1);
      }
    });

    // Avoid triggering click during swipe gestures
    let touchStartX = 0;
    let touchStartY = 0;
    let isSwiping = false;

    track.addEventListener(
      "touchstart",
      (e: TouchEvent) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        isSwiping = false;
      },
      { passive: true }
    );

    track.addEventListener(
      "touchmove",
      (e: TouchEvent) => {
        const dx = Math.abs(e.touches[0].clientX - touchStartX);
        const dy = Math.abs(e.touches[0].clientY - touchStartY);
        if (dx > 10 || dy > 10) {
          isSwiping = true;
        }
      },
      { passive: true }
    );

    // Slide interaction: click or enter/space on neighbor centers it
    items.forEach((item, idx) => {
      item.addEventListener("click", () => {
        if (isSwiping) return;
        if (idx !== currentIndex) {
          scrollToIndex(idx);
        }
      });

      item.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          scrollToIndex(idx);
        }
      });
    });

    // Track scroll events to update active state during manual swipe / scroll-snap
    let scrollRaf = 0;
    track.addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(scrollRaf);
        scrollRaf = requestAnimationFrame(() => {
          const activeIdx = getActiveIndex();
          if (activeIdx !== currentIndex) {
            updateActiveState(activeIdx);
          }
        });
      },
      { passive: true }
    );

    // Keep padding updated on resize / layout shifts
    updateTrackPadding();
    if ("ResizeObserver" in window) {
      const ro = new ResizeObserver(() => {
        updateTrackPadding();
      });
      ro.observe(track);
    } else {
      window.addEventListener("resize", updateTrackPadding);
    }

    // Set initial active state
    updateActiveState(0);
  }

  function initAllCarousels() {
    document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((container) => {
      initCarouselInstance(container);
    });
  }

  initAllCarousels();
  document.addEventListener("astro:page-load", initAllCarousels);
</script>
