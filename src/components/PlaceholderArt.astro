---
// Provisional line-art SVGs — replaced by real CMS photos in phase 4.
interface Props {
  variant: "a" | "b" | "c" | "d" | "hero";
  /** Unique id suffix for pattern elements (use the project slug). */
  id?: string;
}

const { variant, id = "default" } = Astro.props;
const isHero = variant === "hero";
const patternId = `windows-${id}`;
---

{isHero ? (
  <svg
    viewBox="0 0 1200 600"
    preserveAspectRatio="xMidYMax slice"
    class="h-full w-full"
    stroke="currentColor"
    stroke-width="1.5"
    fill="none"
    aria-hidden="true"
  >
    <circle cx="930" cy="170" r="54"/>
    <path d="M0 470H1200"/>
    <rect x="140" y="250" width="360" height="220"/>
    <rect x="110" y="232" width="420" height="18" fill="currentColor"/>
    <rect x="170" y="290" width="200" height="150" fill="currentColor" opacity=".1"/>
    <path d="M220 290V440M270 290V440M320 290V440"/>
    <rect x="500" y="330" width="300" height="140"/>
    <rect x="780" y="300" width="320" height="14" fill="currentColor"/>
    <path d="M800 314V470M1080 314V470"/>
    <circle cx="70" cy="400" r="44"/>
    <path d="M70 444V470"/>
    <path d="M0 490H1200M0 512H1200M0 534H1200" opacity=".25"/>
  </svg>
) : (
  <svg
    viewBox="0 0 400 300"
    preserveAspectRatio="xMidYMid slice"
    class="h-full w-full"
    stroke="currentColor"
    stroke-width="1.5"
    fill="none"
    aria-hidden="true"
  >
    {variant === "a" && (
      <>
        <path d="M0 232H400"/>
        <rect x="70" y="120" width="170" height="112"/>
        <rect x="52" y="108" width="206" height="12" fill="currentColor"/>
        <rect x="240" y="152" width="100" height="80"/>
        <rect x="92" y="146" width="70" height="86" fill="currentColor" opacity=".12"/>
        <path d="M127 146V232M180 120V232"/>
      </>
    )}
    {variant === "b" && (
      <>
        <path d="M0 232H400"/>
        <path d="M60 232V190H140V150H220V110H300V70H340V232"/>
        <path d="M140 190V232M220 150V232M300 110V232" opacity=".5"/>
        <rect x="300" y="62" width="60" height="8" fill="currentColor"/>
        <path d="M60 190L340 70" opacity=".35"/>
      </>
    )}
    {variant === "c" && (
      <>
        <defs>
          <pattern id={patternId} width="20" height="18" patternUnits="userSpaceOnUse">
            <rect x="4" y="4" width="12" height="10" fill="currentColor" opacity=".16" stroke="none"/>
          </pattern>
        </defs>
        <path d="M0 232H400"/>
        <rect x="150" y="30" width="100" height="202" fill={`url(#${patternId})`}/>
        <rect x="110" y="170" width="60" height="62"/>
        <rect x="250" y="120" width="50" height="112"/>
        <path d="M150 232V30M250 232V30"/>
      </>
    )}
    {variant === "d" && (
      <>
        <path d="M0 232H400"/>
        <path d="M50 232V160A35 35 0 0 1 120 160V232M120 232V160A35 35 0 0 1 190 160V232M190 232V160A35 35 0 0 1 260 160V232M260 232V160A35 35 0 0 1 330 160V232"/>
        <rect x="40" y="118" width="300" height="10" fill="currentColor"/>
        <circle cx="360" cy="90" r="18"/>
      </>
    )}
  </svg>
)}
