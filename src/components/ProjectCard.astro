---
import type { SanityProject } from "../lib/queries";
import { getImageProps } from "../lib/images";
import PlaceholderArt from "./PlaceholderArt.astro";

interface Props {
  project: SanityProject;
  position: number; // 0-based position among visible cards (for width logic)
  index: number;    // 0-based global index (for 01, 02… numbering)
  isFirst?: boolean;
}

const { project, position, index, isFirst = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Wide: position % 4 === 0 or 3 ; Narrow: otherwise
const isWide = position % 4 === 0 || position % 4 === 3;
const delay = position * 80; // ms

const displayNumber = String(index + 1).padStart(2, "0");
const imageProps = getImageProps(project.coverImage);
const categorySlug = project.category?.slug || "";
---

<li
  class="project-card reveal"
  data-category={categorySlug}
  style={`
    flex: ${isWide ? "1.7 1 520px" : "1 1 300px"};
    min-width: 0;
    animation-delay: ${delay}ms;
  `}
>
  <a href={`${base}/projekt/${project.slug}`} class="card-link" aria-label={project.title}>
    <!-- Image box -->
    <div
      class="card-image"
      style="background: var(--color-surface, #e5e5e5); color: var(--color-ink);"
    >
      {imageProps ? (
        <img
          src={imageProps.src}
          srcset={imageProps.srcset}
          sizes={isWide ? "(min-width: 1024px) 60vw, 100vw" : "(min-width: 1024px) 35vw, 100vw"}
          width={imageProps.width}
          height={imageProps.height}
          alt={imageProps.alt}
          loading={isFirst ? "eager" : "lazy"}
          decoding={isFirst ? "auto" : "async"}
          fetchpriority={isFirst ? "high" : "auto"}
          style={`
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: ${imageProps.objectPosition};
            display: block;
          `}
        />
      ) : (
        <PlaceholderArt variant="a" id={project.slug} />
      )}
    </div>

    <!-- Card footer -->
    <div class="card-footer">
      <div class="card-footer-left">
        <span class="card-number">{displayNumber}</span>
        <span class="card-title">{project.title}</span>
        <span class="card-arrow" aria-hidden="true">→</span>
      </div>
      {(project.category?.title || project.year) && (
        <span class="card-meta">
          {[project.category?.title, project.year].filter(Boolean).join(" · ")}
        </span>
      )}
    </div>
  </a>
</li>

<style>
  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .card-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .card-image {
    height: 440px;
    overflow: hidden;
  }

  .card-image img,
  .card-image svg {
    transition: transform 1.2s ease;
  }

  @media (hover: hover) {
    .card-link:hover .card-image img,
    .card-link:hover .card-image svg {
      transform: scale(1.035);
    }
    .card-link:hover .card-arrow {
      transform: translateX(8px);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-image img,
    .card-image svg { transition: none; }
    .card-link:hover .card-image img,
    .card-link:hover .card-image svg { transform: none; }
    .card-arrow { transition: none; }
  }

  .card-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    padding-top: 16px;
    gap: 8px;
  }

  .card-footer-left {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .card-number {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .card-title {
    font-size: 22px;
    letter-spacing: -0.01em;
  }

  .card-arrow {
    display: inline-block;
    font-size: 18px;
    transform: translateX(0);
    opacity: 0.5;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .card-link:hover .card-arrow {
    transform: translateX(8px);
    opacity: 1;
  }

  .card-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
</style>
