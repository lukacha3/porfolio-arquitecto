---
import { site } from "../data/site";
import type { SanityProject } from "../lib/queries";
import { getImageProps } from "../lib/images";
import PlaceholderArt from "./PlaceholderArt.astro";

interface Props {
  headline?: string | null;
  featuredProject?: SanityProject | null;
  totalProjects?: number;
}

const { headline, featuredProject, totalProjects = 0 } = Astro.props;
const displayHeading = headline || site.hero.heading;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const heroHref = featuredProject?.slug ? `${base}/projekt/${featuredProject.slug}` : "#";
const imageProps = featuredProject ? getImageProps(featuredProject.coverImage) : null;
---

<section
  style="
    padding: 56px var(--spacing-gutter) 0;
  "
>
  <!-- Heading -->
  <h1
    style="
      font-size: var(--text-display);
      font-weight: 300;
      line-height: 1.02;
      letter-spacing: -0.035em;
      max-width: 13ch;
      margin: 0 0 40px;
    "
  >
    {displayHeading}
  </h1>

  <!-- Data row -->
  <div
    style="
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      font-family: var(--font-mono);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-muted);
    "
  >
    <span>{site.hero.dataLabelLeft}</span>
    <span>{totalProjects} projekt</span>
  </div>

  <!-- Hero image -->
  <a
    href={heroHref}
    class="reveal"
    style="display: block; text-decoration: none; color: inherit;"
    aria-label={featuredProject?.title || displayHeading}
  >
    <div
      class="hero-image-box"
      style="background: var(--color-surface, #e5e5e5); color: var(--color-ink);"
    >
      {imageProps ? (
        <img
          src={imageProps.src}
          srcset={imageProps.srcset}
          sizes="100vw"
          width={imageProps.width}
          height={imageProps.height}
          alt={imageProps.alt}
          loading="eager"
          fetchpriority="high"
          style={`
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: ${imageProps.objectPosition};
            display: block;
          `}
        />
      ) : (
        <PlaceholderArt variant="hero" id={featuredProject?.slug || "hero"} />
      )}
    </div>
  </a>

  <!-- Image caption -->
  {featuredProject && (
    <div
      style="
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: baseline;
        padding-top: 16px;
      "
    >
      <span style="font-size: 22px; letter-spacing: -0.01em;">{featuredProject.title}</span>
      {(featuredProject.category?.title || featuredProject.year) && (
        <span
          style="
            font-family: var(--font-mono);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--color-muted);
          "
        >
          {[featuredProject.category?.title, featuredProject.year].filter(Boolean).join(" · ")}
        </span>
      )}
    </div>
  )}
</section>

<style>
  .hero-image-box {
    overflow: hidden;
    aspect-ratio: 2 / 1;
    min-height: 320px;
  }

  .hero-image-box img,
  .hero-image-box svg {
    transition: transform 1.2s ease;
  }

  .hero-image-box:hover img,
  .hero-image-box:hover svg {
    transform: scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image-box img,
    .hero-image-box svg {
      transition: none;
    }
    .hero-image-box:hover img,
    .hero-image-box:hover svg {
      transform: none;
    }
  }

  a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }
</style>
