---
import type { SanityCoverImage } from "../lib/queries";
import Carousel, { type CarouselSlide } from "./Carousel.astro";

interface Props {
  coverImage: SanityCoverImage;
  gallery?: SanityCoverImage[] | null;
  projectTitle: string;
}

const { coverImage, gallery = [], projectTitle } = Astro.props;

// Combine cover image and gallery images
const allImages: SanityCoverImage[] = [coverImage, ...(gallery || [])].filter(
  (img) => Boolean(img?.asset)
);

const slides: CarouselSlide[] = allImages.map((img) => ({
  image: img,
  caption: img.caption?.trim() || null,
  alt: img.alt?.trim() || img.caption?.trim() || projectTitle,
}));
---

<Carousel
  slides={slides}
  ariaLabel={`Bildgalleri för ${projectTitle}`}
  variant="photos"
  eagerFirst={true}
/>
