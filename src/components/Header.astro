---
import { site } from "../data/site";

interface Props {
  studioName?: string | null;
  showStudio?: boolean;
}

const { studioName, showStudio = false } = Astro.props;
const displayName = studioName || site.studioName;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const navItems = showStudio
  ? site.nav
  : site.nav.filter((item) => item.href !== "#studio");
---

<div class="header-sentinel" data-header-sentinel aria-hidden="true"></div>
<header class="site-header" data-site-header>
  <!-- Studio name -->
  <a href={`${base}/`} class="studio-brand">
    {displayName}
  </a>

  <!-- Navigation -->
  <nav aria-label="Huvudnavigation">
    <ul class="nav-list">
      {navItems.map((item) => (
        <li>
          <a href={`${base}/${item.href}`} class="nav-link">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .header-sentinel {
    height: 1px;
    width: 100%;
    margin-bottom: -1px;
    pointer-events: none;
  }

  .site-header {
    position: sticky;
    top: var(--preview-offset, 0px);
    z-index: 900;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    row-gap: 8px;
    column-gap: 24px;
    padding: 20px var(--spacing-gutter);
    background-color: var(--color-ink);
    color: var(--color-ground);
    border-bottom: 1px solid transparent;
    transition:
      padding 220ms ease,
      background-color 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease;
  }

  .site-header.is-scrolled {
    padding-top: 12px;
    padding-bottom: 12px;
    border-bottom-color: rgba(236, 234, 229, 0.14);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.18);
  }

  @supports (backdrop-filter: blur(10px)) or (-webkit-backdrop-filter: blur(10px)) {
    .site-header.is-scrolled {
      background-color: color-mix(in srgb, var(--color-ink) 92%, transparent);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
  }

  .studio-brand {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 8px 0;
    line-height: 1;
    color: inherit;
    text-decoration: none;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 8px 0;
    display: inline-block;
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  .nav-link:hover {
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  .nav-link:focus-visible,
  .studio-brand:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
</style>

<script>
  function initStickyHeader() {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const sentinel = document.querySelector<HTMLElement>("[data-header-sentinel]");
    if (!header || !sentinel || header.dataset.stickyBound === "true") return;
    header.dataset.stickyBound = "true";

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            header.classList.toggle("is-scrolled", !entry.isIntersecting);
          }
        },
        { threshold: 0 }
      );
      observer.observe(sentinel);
    }
  }

  initStickyHeader();
  document.addEventListener("astro:page-load", initStickyHeader);
</script>
