---
import { site } from "../data/site";
import { getStudioParagraphs, getStudioServices } from "../lib/studio";

interface Props {
  about?: string | null;
  services?: (string | null | undefined)[] | null;
}

const { about, services } = Astro.props;
const paragraphs = getStudioParagraphs(about);
const sanityServices = getStudioServices(services);
const hasContent = paragraphs.length > 0 || sanityServices.length > 0;
---

{hasContent && (
  <section
    id="studio"
    style="
      margin-top: 112px;
      padding: 48px var(--spacing-gutter) 120px;
      display: flex;
      flex-wrap: wrap;
      gap: 48px;
    "
  >
    <!-- Label column -->
    <div style="flex: 1 1 240px;">
      <h2
        class="section-title"
        style="margin: 0;"
      >
        {site.studio.label}
      </h2>
    </div>

    <!-- Main column -->
    <div style="flex: 3 1 480px; min-width: 0;">
      <!-- Statement with paragraphs -->
      {paragraphs.length > 0 && (
        <div style={`max-width: 28ch; margin: 0 0 ${sanityServices.length > 0 ? "80px" : "0"};`}>
          {paragraphs.map((para) => (
            <p
              class="section-title"
              style="margin: 0 0 24px;"
            >
              {para}
            </p>
          ))}
        </div>
      )}

      <!-- Services -->
      {sanityServices.length > 0 && (
        <ul
          style="
            display: flex;
            flex-wrap: wrap;
            row-gap: 40px;
            column-gap: 32px;
            list-style: none;
            margin: 0;
            padding: 0;
          "
        >
          {sanityServices.map((serviceName, index) => (
            <li
              style="
                flex: 1 1 200px;
                border-top: 1px solid var(--color-line);
                padding-top: 16px;
              "
            >
              <p
                style="
                  font-family: var(--font-mono);
                  font-size: 12px;
                  text-transform: uppercase;
                  letter-spacing: 0.08em;
                  margin: 0 0 12px;
                "
              >
                {String(index + 1).padStart(2, "0")} {serviceName}
              </p>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
)}
