---
import "../styles/global.css";
import { site } from "../data/site";
import { isPreview } from "../lib/preview";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, any>;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const {
  title       = site.page.title,
  description = site.page.description,
  image,
  jsonLd,
} = Astro.props;

// Absolute canonical URL
const siteOrigin = Astro.site ? new URL(Astro.site).origin : 'https://lukacha3.github.io';
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

    <!-- Mark js presence early to prevent layout shift and hide-without-js -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    {isPreview && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={image} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}

    <!-- Structured Data JSON-LD -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="bg-ground text-ink font-sans min-h-screen">
    <!-- Skip to content link for accessibility -->
    <a href="#main" class="skip-link">Hoppa till innehåll</a>

    {isPreview && (
      <aside
        class="preview-banner"
        role="status"
        aria-live="polite"
      >
        <div class="preview-banner-content">
          <span class="preview-dot" aria-hidden="true"></span>
          <span>Förhandsvisning — utkast visas</span>
        </div>
      </aside>
    )}
    <slot />

    <!-- Smooth motion and entrance animations -->
    <script src="../scripts/motion.ts"></script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100px;
    left: var(--spacing-gutter);
    background: var(--color-ink);
    color: var(--color-ground);
    padding: 12px 20px;
    font-family: var(--font-mono);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    z-index: 9999;
    text-decoration: none;
    transition: top 0.2s ease;
    border-radius: 0 0 4px 4px;
  }

  .skip-link:focus {
    top: 0;
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .preview-banner {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: var(--color-ink, #1a1a1a);
    color: var(--color-ground, #fafafa);
    border-bottom: 1px solid var(--color-accent, #5b6b4f);
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 8px var(--spacing-gutter);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .preview-banner-content {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: center;
  }

  .preview-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent, #5b6b4f);
    display: inline-block;
  }
</style>
